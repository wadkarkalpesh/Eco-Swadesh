rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.roles != null && role in request.auth.token.roles;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && request.auth.token.roles != null && request.auth.token.roles.hasAny(roles);
    }

    // Public listings media
    match /listings-media/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Phase 4: Restricted certification documents
    match /certification-docs/{allPaths=**} {
      // Direct Storage URL read locked to moderators/admins or the uploader
      allow read: if isSignedIn() && (
        hasAnyRole(['moderator', 'admin']) ||
        resource.metadata.uploadedBy == request.auth.uid
      );
      // Only sellers or admins can upload verification certificates
      allow write: if isSignedIn() && (hasRole('seller') || hasRole('admin'));
    }

    // Default deny-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
