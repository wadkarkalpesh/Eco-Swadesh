{
  "name": "deccan-origin-backend",
  "version": "1.0.0",
  "description": "Deccan Origin Production Backend API Server - Organic Agriculture, Bulk Harvest, Escrow, IoT Freight, AI Doctor, and Trust Verification",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/fullStackIntegration.test.js",
    "test:all": "node tests/api.test.js && node tests/fullStackIntegration.test.js",
    "python:start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 5000",
    "python:dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload"
  },
  "keywords": [
    "deccan-origin",
    "organic-agriculture",
    "escrow",
    "iot-freight",
    "apeda-npop",
    "ai-agronomy",
    "express",
    "supabase",
    "postgresql"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "author": "Deccan Origin Engineering Team",
  "license": "MIT"
}
